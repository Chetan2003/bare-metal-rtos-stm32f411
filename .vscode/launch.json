{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Debug RTOS (ST-Link)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "deviceName": "STM32F411RETx",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": "4"
            },
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/RTOS.elf"
                }
            ]
        }
    ]
}
